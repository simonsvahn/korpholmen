{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://korpholmen.example/schema/master-change-v2.json",
  "title": "En uttrycklig Spara-gest i Korpholmen generation 2",
  "type": "object",
  "required": ["change_id", "expected_master_revision", "expected_storage_revision", "changed_at", "changed_by", "mutations"],
  "properties": {
    "change_id": { "type": "string", "minLength": 1 },
    "expected_master_revision": { "type": "integer", "minimum": 0 },
    "expected_storage_revision": { "type": ["string", "integer"] },
    "changed_at": { "type": "string", "format": "date-time" },
    "changed_by": { "type": "string", "minLength": 1 },
    "manual_comment": { "type": "string" },
    "mutations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["collection", "entity_id", "action"],
        "properties": {
          "collection": { "type": "string", "minLength": 1 },
          "entity_id": { "type": "string", "minLength": 1 },
          "action": { "enum": ["upsert", "delete", "restore"] },
          "set": { "type": "object" },
          "unset": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
